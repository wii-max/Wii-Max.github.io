group :jekyll_plugins do
  gem 'jekyll', '~> 4.4.1'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jekyll-gist'
  gem 'jekyll-paginate'
  gem 'jemoji'
end

gem 'kramdown'
gem 'kramdown-parser-gfm'

# Windows only (needed for local builds; skipped on Linux CI)
gem 'tzinfo-data', platforms: [:mingw, :mswin, :x64_mingw, :jruby]
